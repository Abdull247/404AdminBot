{
  "id": "riverai",
  "name": "RiverAI",
  "enabled": true,
  "default": true,
  "priority": 100,
  "kind": "openai-compatible",
  "freeTier": true,
  "baseUrl": { "env": "AI_BASE_URL", "required": true },
  "apiKey": { "env": "AI_API_KEY", "required": true },
  "timeoutMs": { "env": "AI_TIMEOUT_MS", "required": false },
  "notes": "Current production endpoint. Keep as default so existing AI_BASE_URL / AI_API_KEY deploys keep working."
}
