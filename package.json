{
  "name": "whatsapp-ai-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Expandable WhatsApp and Telegram AI bot using Baileys, Telegram Bot API, and Neon",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "probe:hcnsec": "bash scripts/probe-hcnsec.sh",
    "probe:agnes": "bash scripts/probe-agnes.sh",
    "probe:nvidia": "bash scripts/probe-nvidia.sh",
    "probe:kira": "bash scripts/probe-kira.sh",
    "probe:providers": "bash scripts/probe-providers.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@e2b/code-interpreter": "^2.3.3",
    "@hapi/boom": "^10.0.1",
    "@insforge/instabox-sdk": "^0.5.3",
    "@neondatabase/serverless": "^0.10.4",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.4"
  }
}
